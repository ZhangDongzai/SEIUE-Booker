# 监听地址与端口
# 0.0.0.0 = 手机/局域网都能访问；只想本机用就改 127.0.0.1
APP_HOST=0.0.0.0
APP_PORT=8080
# 数据目录。留空 = 项目内的 data/
# DATA_DIR=
# 访问口令（留空则不鉴权）
APP_PASSWORD=
# 时区
APP_TZ=Asia/Shanghai
# 出网代理（默认直连；必须过代理时才填，如 http://192.168.1.2:7890）
APP_PROXY=
# 令牌自动续期：剩余不足多少秒就换（默认 600，与站点前端一致）
TOKEN_REFRESH_SKEW=600
# 后台巡检间隔（秒）
TOKEN_CHECK_SECONDS=300
# 免密换令牌：passport 域的 authorize 地址与 web client id（默认值来自前端 bundle，一般不用改）
PASSPORT_AUTHORIZE_URL=https://passport.seiue.com/authorize
PASSPORT_WEB_CLIENT_ID=GpxvnjhVKt56qTmnPWH1sA
